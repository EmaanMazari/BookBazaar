# ========================================================
# BookBazaar Pakistan - Production Environment Configuration
# Template: Rename to .env on production Linux/Ubuntu server
# ========================================================

# 1. Security & Core Django
# Generate a fresh 50+ character secret key (e.g., using: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
DEBUG=False
ALLOWED_HOSTS=bookbazaar.pk,www.bookbazaar.pk,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://bookbazaar.pk,https://www.bookbazaar.pk
CORS_ALLOWED_ORIGINS=https://bookbazaar.pk,https://www.bookbazaar.pk

# 2. Production PostgreSQL 18 Configuration
USE_POSTGRES=True
DB_NAME=bookbazaar_db
DB_USER=bookbazaar_user
DB_PASSWORD=YOUR_STRONG_POSTGRESQL_PRODUCTION_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# 3. Production HTTPS, Cookies & Security Headers
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# 4. API Rate Limiting (DRF Throttling)
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=200/min

# 5. Production Logging
DJANGO_LOG_LEVEL=WARNING

# 6. Payment Gateway Configuration (JazzCash & Easypaisa)
# Set to 'live' ONLY after receiving approved merchant credentials from Mobilink & Telenor Bank.
# Keep as 'sandbox' during staging, QA, and evaluation.
PAYMENT_GATEWAY_MODE=sandbox

# Mobilink JazzCash Merchant Credentials
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://bookbazaar.pk/api/payments/jazzcash/callback/

# Telenor Easypaisa Merchant Credentials
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=https://bookbazaar.pk/api/payments/easypaisa/callback/
