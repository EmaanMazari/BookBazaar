# ==========================================
# BookBazaar Environment Configuration Template
# Copy this file to .env and adjust variables
# ==========================================

# Core Django Settings
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration
# Set USE_POSTGRES=True to use PostgreSQL; set USE_POSTGRES=False to use SQLite
USE_POSTGRES=True
DB_NAME=bookbazaar_db
DB_USER=bookbazaar_user
DB_PASSWORD=your_strong_generated_password
DB_HOST=127.0.0.1
DB_PORT=5432

# DRF Throttling Rates
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=200/min

# HTTPS and Cookie Security (For Production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging
DJANGO_LOG_LEVEL=INFO

# ==========================================
# Payment Gateway Configuration (Phase 3)
# ==========================================
# Set to 'sandbox' for local development & testing, or 'live' for real merchant gateways
PAYMENT_GATEWAY_MODE=sandbox

# JazzCash Merchant Credentials (from Mobilink Microfinance Bank merchant portal)
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id
JAZZCASH_PASSWORD=your_jazzcash_merchant_password
JAZZCASH_INTEGRITY_SALT=your_jazzcash_integrity_salt
JAZZCASH_RETURN_URL=http://127.0.0.1:8000/api/payments/jazzcash/callback/

# Easypaisa Merchant Credentials (from Telenor Microfinance Bank merchant portal)
EASYPAISA_STORE_ID=your_easypaisa_store_id
EASYPAISA_HASH_KEY=your_easypaisa_hash_key
EASYPAISA_RETURN_URL=http://127.0.0.1:8000/api/payments/easypaisa/callback/
